# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Add when you wire up the real agent (free tiers: Gemini via AI Studio, or Groq).
GEMINI_API_KEY=
GROQ_API_KEY=

# Add when you wire up the database/auth (Supabase free plan).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
