# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Supabase (Project Settings → API). The secret/service_role key bypasses RLS:
# server only, never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Where this API and the frontend are reachable (used for the Gmail OAuth redirect).
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Google Cloud OAuth client (Web application). Add this redirect URI to it:
#   {API_PUBLIC_URL}/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts Gmail refresh tokens. Generate once and keep it stable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Shared with the GitHub Actions daily sync (any long random string).
CRON_SECRET=

# Optional: LLM email classifier (free tier at aistudio.google.com).
# Without it, a keyword-based classifier is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
